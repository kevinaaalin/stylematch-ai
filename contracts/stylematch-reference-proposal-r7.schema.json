{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tigi.tw/schemas/stylematch/reference-proposal/r7",
  "title": "StyleMatch R7 Reference and Proposal Workflow",
  "type": "object",
  "required": ["schema_version", "project_id", "case_code", "reference_revisions", "confirmed_reference_sets", "point_ledger"],
  "properties": {
    "schema_version": { "const": "stylematch.reference-proposal.r7.v1" },
    "project_id": { "type": "string", "minLength": 1 },
    "case_code": { "type": "string", "minLength": 1 },
    "reference_revisions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["revision_id", "space", "image_url", "version", "status", "created_at"],
        "properties": {
          "revision_id": { "type": "string" },
          "space": { "type": "string" },
          "image_url": { "type": "string" },
          "source_image_url": { "type": ["string", "null"] },
          "instruction": { "type": "string" },
          "version": { "type": "integer", "minimum": 1 },
          "status": { "enum": ["candidate", "adopted"] },
          "source_task_id": { "type": ["string", "null"] },
          "created_at": { "type": "string", "format": "date-time" }
        }
      }
    },
    "confirmed_reference_sets": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["confirmed_reference_set_id", "version", "revision_ids", "images", "status", "confirmed_at"],
        "properties": {
          "confirmed_reference_set_id": { "type": "string" },
          "version": { "type": "integer", "minimum": 1 },
          "revision_ids": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
          "images": { "type": "array", "minItems": 1 },
          "status": { "const": "confirmed" },
          "confirmed_at": { "type": "string", "format": "date-time" }
        }
      }
    },
    "point_ledger": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["transaction_id", "idempotency_key", "project_id", "type", "points", "status", "created_at"],
        "properties": {
          "transaction_id": { "type": "string" },
          "idempotency_key": { "type": "string" },
          "type": { "const": "proposal_generation" },
          "points": { "type": "integer", "maximum": -1 },
          "status": { "const": "completed" },
          "confirmed_reference_set_id": { "type": "string" },
          "created_at": { "type": "string", "format": "date-time" }
        }
      }
    }
  }
}
