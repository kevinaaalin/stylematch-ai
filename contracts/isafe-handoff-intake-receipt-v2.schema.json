{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.stylematch.ai/contracts/isafe-handoff-intake-receipt-v2.schema.json",
  "title": "iSAFE Handoff V2 Intake Receipt",
  "type": "object",
  "required": ["schema_version", "receipt_id", "handoff_id", "status", "received_manifest_checksum", "authority_boundary", "receipt_checksum"],
  "properties": {
    "schema_version": { "const": "iSAFE.HandoffIntakeReceipt/2.0" },
    "receipt_id": { "type": "string", "minLength": 1 },
    "handoff_id": { "type": "string", "minLength": 1 },
    "status": { "const": "intake_received" },
    "received_manifest_checksum": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "authority_boundary": {
      "type": "object",
      "required": ["case_created", "gate_decision", "r5_2_state_transition"],
      "properties": {
        "case_created": { "const": false },
        "gate_decision": { "const": false },
        "r5_2_state_transition": { "const": false }
      },
      "additionalProperties": false
    },
    "receipt_checksum": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
  },
  "additionalProperties": true
}
