{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://stylematch.tw/contracts/style-vision-embedding.v1.schema.json",
  "type": "object",
  "required": ["contract_version", "catalog_version", "model", "similarity", "prompt_template", "styles"],
  "properties": {
    "contract_version": { "const": "stylematch.style-vision-embedding.v1" },
    "catalog_version": { "const": "stylematch.style-catalog.v1" },
    "model": {
      "type": "object",
      "required": ["model_id", "revision", "embedding_dimensions", "weights_sha256", "local_path"]
    },
    "similarity": {
      "type": "object",
      "required": ["normalization", "metric", "temperature", "top_k", "automatic_acceptance_threshold", "minimum_margin", "requires_human_confirmation"]
    },
    "prompt_template": { "type": "string", "minLength": 20 },
    "styles": {
      "type": "array",
      "minItems": 30,
      "maxItems": 30,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "name", "description"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
          "name": { "type": "string", "minLength": 2 },
          "description": { "type": "string", "minLength": 20 }
        }
      }
    }
  }
}
